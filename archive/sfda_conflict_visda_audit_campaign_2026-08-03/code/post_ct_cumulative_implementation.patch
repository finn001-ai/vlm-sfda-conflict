+        for name in ("car", "person", "truck")
+    ]
+    gate = evaluate_preflight_gate(
+        reproduction_passed=True,
+        auc_gain=0.03,
+        auc_ci=(0.01, 0.05),
+        quintile_accuracy_gap_pp=6.0,
+        harmful_reduction_percent=20.0,
+        helpful_retention_percent=96.0,
+        classwise=classwise,
