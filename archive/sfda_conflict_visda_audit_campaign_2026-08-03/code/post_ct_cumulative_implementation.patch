+    passing = _summary(80.3, [80.3] * 12)
+    exchanged = [80.3] * 12
+    for index in (0, 1, 2, 4, 5, 6, 8, 9, 10):
+        exchanged[index] = 79.9
+    failing = _summary(80.3, exchanged)
