+
+    # Phase 2: target labels are revealed only for explicit oracle diagnostics.
+    all_label = _parse_labels_after_lock(cfg.t_dset_path, ordered_paths)
+    all_mask = np.ones(all_label.size, dtype=bool)
+    agreement = ~conflict
+    baseline_observed = {
