+#!/usr/bin/env bash
+set -euo pipefail
+
+seed=2020
+method="duet_clip_confidence_delay_visda_proxy25_seed${seed}"
+proxy_list="data/VISDA-C/validation_proxy25_seed2020_list.txt"
+candidate_dir="output/uda/VISDA-C/TV/${method}"
+result_dir="output/uda/VISDA-C"
