+    oracle_path = out_dir / f"{stem}_oracle_diagnostic.csv"
+    summary_path = out_dir / f"{stem}_summary.json"
+    markdown_path = out_dir / f"{stem}_summary.md"
+    _write_csv(signal_path, signal_rows)
+    _write_csv(oracle_path, oracle_rows)
